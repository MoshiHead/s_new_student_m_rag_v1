# ---------------------------------------------------------------------------
# Layer selection
# ---------------------------------------------------------------------------

def select_layers(n_teacher: int, n_keep: int, strategy: str = "spaced",
                  keep_first: int = 2, keep_last: int = 4) -> list[int]:
    """Return the teacher layer indices to keep, in order.

    ``strategy="spaced"`` removes layers evenly across the middle; the first
    ``keep_first`` and last ``keep_last`` layers are always kept.  ``strategy=
    "contiguous"`` keeps the front block plus the tail.
    """
    assert 0 < n_keep <= n_teacher, (n_keep, n_teacher)
    if n_keep == n_teacher:
        return list(range(n_teacher))
    first = list(range(min(keep_first, n_teacher)))
    last = list(range(max(keep_first, n_teacher - keep_last), n_teacher))
    middle = [i for i in range(n_teacher) if i not in first and i not in last]
    need = n_keep - len(first) - len(last)
    if need <= 0:
        # n_keep small: keep first/last then fill from the middle edges
        keep = first + last
        return sorted(keep[:n_keep]) if keep_first + keep_last >= n_keep else \
            sorted((first[:n_keep // 2] + last[-(n_keep - n_keep // 2):]))
    if strategy == "spaced":
        if need >= len(middle):
            chosen = middle
        else:
            # evenly spaced picks across the middle block
            step = len(middle) / need
            chosen = [middle[min(len(middle) - 1, int(round((k + 0.5) * step - 0.5)))]
                      for k in range(need)]
            chosen = sorted(set(chosen))
            j = 0
            while len(chosen) < need and j < len(middle):
                if middle[j] not in chosen:
                    chosen.append(middle[j])
                    chosen = sorted(chosen)
                j += 1
    elif strategy == "contiguous":
        # keep the front block + a contiguous middle block ending at the tail
        chosen = middle[:need]
    else:
        raise ValueError(f"unknown strategy {strategy!r}")
    return sorted(first + chosen + last)


@torch.no_grad()
def block_influence(model, codes: torch.Tensor, feat_layers: list[int] | None = None
                    ) -> torch.Tensor:
    """Per-layer block influence ``1 - cos(h_in, h_out)`` averaged over frames.

    Cheap ranking signal for which layers do the least to the hidden state.
    ``feat_layers`` defaults to all transformer layers.
    """
    if feat_layers is None:
        feat_layers = list(range(len(model.transformer.layers)))
    ins: dict[int, torch.Tensor] = {}
    outs: dict[int, torch.Tensor] = {}
    handles = []
    for l in feat_layers:
        handles.append(model.transformer.layers[l].register_forward_hook(
            (lambda l: (lambda m, i, o: outs.__setitem__(l, _as_tensor(o))))(l)))
    hidden = forward_distill(model, codes)["hidden"]
    for h in handles:
        h.remove()
    # h_in is not directly available; recompute by capturing the layer input
    # through a pre-hook instead.
    handles = []
    for l in feat_layers:
        handles.append(model.transformer.layers[l].register_forward_pre_hook(
            (lambda l: (lambda m, i: ins.__setitem__(l, _as_tensor(i[0]))))(l)))
    _ = forward_distill(model, codes)["hidden"]
    for h in handles:
        h.remove()
    bi = []
    for l in feat_layers:
        a = ins[l].float().reshape(-1, ins[l].shape[-1])
        b = outs[l].float().reshape(-1, outs[l].shape[-1])
        cos = F.cosine_similarity(a, b, dim=-1)
        bi.append(float((1.0 - cos).mean()))
    return torch.tensor(bi)


def _as_tensor(o):
    if isinstance(o, (tuple, list)):
        return o[0]
    return o


# ---------------------------------------------------------------------------
# Student construction
# ---------------------------------------------------------------------------

def build_student(teacher: LMModel, kept_layers: list[int],
                  base_kwargs: dict, device=None, dtype=None,
                  freeze_depformer: bool = True) -> LMModel:
    """Build an `LMModel` with ``len(kept_layers)`` layers, teacher-initialised.

    ``base_kwargs`` is the teacher's constructor kwargs (e.g. `loaders._lm_kwargs`
    with ``dep_q`` set); ``num_layers`` is overridden.  Student layer ``i`` takes
    the weights of teacher layer ``kept_layers[i]``; every other tensor
    (embeddings, out_norm, text head, DepFormer) is copied verbatim.
    """
    kw = dict(base_kwargs)
    kw["num_layers"] = len(kept_layers)
    student = LMModel(device=device, dtype=dtype, **kw)

    t_sd = teacher.state_dict()
    s_sd = student.state_dict()
    new_sd = {}
    for k in s_sd:
        if "transformer.layers." in k:
            pre, rest = k.split("transformer.layers.", 1)
            idx_str, suffix = rest.split(".", 1)
            new_sd[k] = t_sd[
                f"{pre}transformer.layers.{kept_layers[int(idx_str)]}.{suffix}"]
        elif k in t_sd:
            new_sd[k] = t_sd[k]
        else:
            raise KeyError(f"student key {k!r} has no teacher counterpart")
    missing, unexpected = student.load_state_dict(new_sd, strict=False)
    if unexpected:
        raise RuntimeError(f"unexpected keys when copying teacher weights: {unexpected[:5]}")
    if missing:
        # only the deliberately-pruned layer slots (they are filled above)
        raise RuntimeError(f"missing keys when copying teacher weights: {missing[:5]}")

    # `LMModel` builds text_linear / out_norm / depformer_in / linears without
    # device/dtype, so move the assembled student explicitly.
    if device is not None:
        student = student.to(device)
    if dtype is not None:
        student = student.to(dtype)

    if freeze_depformer:
        for mod in (student.depformer, student.depformer_in, student.depformer_emb,
                    student.depformer_text_emb, student.linears):
            for p in mod.parameters():
                p.requires_grad_(False)
    return student


def teacher_kwargs(dep_q: int = 16) -> dict:
    """Constructor kwargs for the released PersonaPlex/Moshi backbone.

    Use with :func:`build_student`::
        build_student(teacher, select_layers(32, 16), teacher_kwargs())
    """
    from .models import loaders
    kw = dict(loaders._lm_kwargs)
    kw["dep_q"] = dep_q
    return kw


def finetune_top_layers(student: LMModel, n_trainable: int) -> None:
    """Freeze all transformer layers except the top ``n_trainable``."""
    layers = student.transformer.layers
    for i, layer in enumerate(layers):
        keep = i >= (len(layers) - n_trainable)
        for p in layer.parameters():
            p.requires_grad_(keep)


def freeze_embeddings_and_heads(student: LMModel, freeze: bool = True) -> None:
    """Freeze/unfreeze embeddings, out_norm and the text head (plan §5.3)."""
    mods = [student.emb, student.text_emb, student.out_norm, student.text_linear]
    for mod in mods:
        if mod is None:
            continue
        for p in mod.parameters():
            p.requires_grad_(not freeze)


# ---------------------------------------------------------------------------
# Teacher-forced forward (frozen teacher OR student)
# ---------------------------------------------------------------------------

def forward_distill(model: LMModel, codes: torch.Tensor,
                    feat_layers: list[int] | None = None
                    ) -> dict[str, torch.Tensor]:
    """One teacher-forced pass mirroring ``LMModel.forward_train``.

    Returns post-``out_norm`` hidden states (the DepFormer/text-head input),
    undelayed text logits, undelayed DepFormer audio logits and their masks.
    ``feat_layers`` additionally captures those transformer layers' outputs.
    """
    B, K, T = codes.shape
    assert K == model.num_codebooks, (K, model.num_codebooks)

    initial = model._get_initial_token().expand(B, -1, -1)
    delayed = _delay_sequence(model.delays, codes, initial)
    delayed = torch.cat([initial, delayed], dim=2)          # [B, K, T+1]

    emb = model.embed_codes(delayed[:, :, :-1])

    feats: dict[int, torch.Tensor] = {}
    handles = []
    if feat_layers:
        for l in feat_layers:
            handles.append(model.transformer.layers[l].register_forward_hook(
                (lambda l: (lambda m, i, o: feats.__setitem__(l, _as_tensor(o))))(l)))
    transformer_out, _ = model.forward_embeddings(emb)       # post out_norm
    for h in handles:
        h.remove()

    text_logits = model.text_linear(transformer_out)[:, None]
    audio_logits = model.forward_depformer_training(delayed[:, :, 1:], transformer_out)

    audio_logits, audio_mask = _undelay_sequence(
        model.delays[model.audio_offset:model.audio_offset + model.dep_q],
        audio_logits, fill_value=float("nan"))
    audio_mask &= (codes[:, model.audio_offset:model.audio_offset + model.dep_q]
                   != model.zero_token_id)
    text_logits, text_mask = _undelay_sequence(
        model.delays[:1], text_logits, fill_value=float("nan"))
    text_mask &= (codes[:, :1] != model.zero_token_id)

    return {
        "hidden": transformer_out,          # [B, T, D] post out_norm
        "text_logits": text_logits,         # [B, 1, T, text_card]
        "text_mask": text_mask,             # [B, 1, T]
        "audio_logits": audio_logits,       # [B, dep_q, T, card]
        "audio_mask": audio_mask,           # [B, dep_q, T]
        "feats": feats,                     # {layer: [B, T, D]}
    }


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------

def _wmean(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
    w = w.float()
    return (x.float() * w).sum() / w.sum().clamp(min=1e-8)


def loss_hidden(s_h: torch.Tensor, t_h: torch.Tensor, frame_valid: torch.Tensor,
                cos_weight: float = 1.0) -> torch.Tensor:
    """``mse(s_h/σ_t, t_h/σ_t) + cos_weight*(1 - cos)`` (plan §5.1, §7.4)."""
    sigma = t_h.detach().float().std(dim=(0, 1), unbiased=False).clamp_min(1e-4)
    mse = ((s_h.float() - t_h.float()) / sigma).square().mean(-1)   # [B, T]
    cos = 1.0 - F.cosine_similarity(s_h.float(), t_h.float(), dim=-1)
    return _wmean(mse + cos_weight * cos, frame_valid)


def _flat_kl(p_logits, q_logits, mask, temperature):
    p = torch.softmax(p_logits.float() / temperature, dim=-1)
    logq = torch.log_softmax(q_logits.float() / temperature, dim=-1)
    kl = (p * (p.clamp_min(1e-12).log() - logq)).sum(-1)
    return _wmean(kl, mask)


def _topk_kl(p_logits, q_logits, mask, k, temperature):
    v = p_logits.size(-1)
    kk = min(int(k), v)
    idx = torch.topk(p_logits.float(), kk, dim=-1).indices
    p_at = p_logits.float().gather(-1, idx)
    q_at = q_logits.float().gather(-1, idx)
    p = torch.softmax(p_at / temperature, dim=-1)
    logq = torch.log_softmax(q_at / temperature, dim=-1)
    kl = (p * (p.clamp_min(1e-12).log() - logq)).sum(-1)
    return _wmean(kl, mask)


def loss_text(s_text_logits, t_text_logits, text_mask, text_codes,
              pad_ids, temperature: float = 1.0, top_k: int = 25,
              samp_temp: float = 0.7, nonpad_weight: float = 3.0) -> torch.Tensor:
    """Text KD: full KL + top-k/temp-matched KL, non-PAD frames up-weighted.

    PAD dominates the text stream (plan §7.3); without the up-weight the student
    collapses to PAD.
    """
    p = torch.nan_to_num(t_text_logits.float(), nan=0.0)
    q = torch.nan_to_num(s_text_logits.float(), nan=0.0)
    mask = text_mask.float()
    nonpad = torch.ones_like(mask)
    for pid in pad_ids:
        nonpad = nonpad * (text_codes[:, None] != pid).float()
    w = mask * (1.0 + (nonpad_weight - 1.0) * nonpad)
    full = _flat_kl(p, q, w, temperature)
    topk = _topk_kl(p, q, w, top_k, samp_temp)
    return full + topk


def loss_audio(s_audio_logits, t_audio_logits, audio_mask,
               codebook_weights: torch.Tensor | None = None,
               agent_only: bool = True, frame_keep: float = 1.0,
               temperature: float = 1.0) -> torch.Tensor:
    """Frozen-DepFormer KD on the student's and teacher's hidden states.

    Gradients flow through the student hidden (the DepFormer is frozen).  Only
    agent slots participate by default (the user stream is provided at serving).
    """
    p = torch.nan_to_num(t_audio_logits.float(), nan=0.0)
    q = torch.nan_to_num(s_audio_logits.float(), nan=0.0)
    B, Ka, T, card = q.shape
    if agent_only:
        Ka = min(8, Ka)
        p, q = p[:, :Ka], q[:, :Ka]
    mask = audio_mask[:, :Ka].float()
    if frame_keep < 1.0:
        keep = (torch.rand_like(mask) < frame_keep).float()
        mask = mask * keep
    if codebook_weights is None:
        codebook_weights = torch.ones(Ka, device=q.device)
    w = codebook_weights.to(q.device).float().view(1, -1, 1)
    p_s = torch.softmax(p / temperature, dim=-1)
    logq = torch.log_softmax(q / temperature, dim=-1)
    kl = (p_s * (p_s.clamp_min(1e-12).log() - logq)).sum(-1)   # [B, Ka, T]
    ww = mask * w
    return (kl * ww).sum() / ww.sum().clamp(min=1e-8)


def loss_feat(s_feats: dict[int, torch.Tensor], t_feats: dict[int, torch.Tensor],
              frame_valid: torch.Tensor) -> torch.Tensor:
    """Mapped-intermediate-layer MSE (student layer i -> teacher layer map[i])."""
    total = None
    for s_l, t_l in zip(s_feats, t_feats):
        s = s_feats[s_l]
        t = t_feats[t_l]
        sigma = t.detach().float().std(dim=(0, 1), unbiased=False).clamp_min(1e-4)
        per = ((s.float() - t.float()) / sigma).square().mean(-1)
        term = _wmean(per, frame_valid)
        total = term if total is None else total + term
    return total if total is not None else torch.zeros((), device=frame_valid.device)


@dataclass
class BackboneDistillWeights:
    hidden: float = 1.0
    feat: float = 1.0
    text: float = 1.0
    audio: float = 0.5
    audio_frame_keep: float = 0.25
    stage1_frac: float = 0.2


def frame_valid_mask(codes: torch.Tensor, offset: int,
                     zero_token_id: int) -> torch.Tensor:
    """[B, T] valid-frame mask from the first audio codebook (plan §7.1)."""
    return codes[:, offset] != zero_token_id


def backbone_distill_loss(s_out: dict, t_out: dict, codes: torch.Tensor,
                          frame_valid: torch.Tensor,
                          pad_ids: set[int] | tuple[int, ...],
                          weights: BackboneDistillWeights, stage: int
                          ) -> tuple[torch.Tensor, dict[str, float]]:
    """Assemble the stage objective (plan §5.1).

    stage 1: ``w_h*L_h + w_feat*L_feat``
    stage 2: ``w_h*L_h + w_text*L_text + w_audio*L_audio``
    """
    stats: dict[str, float] = {}
    l_h = loss_hidden(s_out["hidden"], t_out["hidden"], frame_valid)
    total = weights.hidden * l_h
    stats["hidden"] = float(l_h)

    if stage == 1:
        if s_out["feats"] and t_out["feats"]:
            l_f = loss_feat(s_out["feats"], t_out["feats"], frame_valid)
            total = total + weights.feat * l_f
            stats["feat"] = float(l_f)
    else:
        l_t = loss_text(s_out["text_logits"], t_out["text_logits"],
                        t_out["text_mask"], codes[:, 0], pad_ids)
        total = total + weights.text * l_t
        stats["text"] = float(l_t)

        l_a = loss_audio(s_out["audio_logits"], t_out["audio_logits"],
                         t_out["audio_mask"],
                         frame_keep=weights.audio_frame_keep)
        total = total + weights.audio * l_a
        stats["audio"] = float(l_a)

    stats["loss"] = float(total)
    return total, stats


# ---------------------------------------------------------------------------
# Batched rollout token generation (plan §3.1/§3.3)
# ---------------------------------------------------------------------------

@torch.no_grad()
def rollout_tokens_batched(teacher_lm, samples, device="cuda", temp: float = 0.8,
                           top_k: int = 250, batch_size: int = 32,
                           max_frames: int | None = None,
                           pad_token_id: int | None = None
                           ) -> list[torch.Tensor]:
    """Batched teacher rollouts, **tokens only** (plan §3.1/§3.3).

    ``samples`` is a list of ``(codes, prompt_len)`` where ``codes`` is
    ``[1, 17, T]`` (system-prompt block already prepended by the interleaver)
    and ``prompt_len`` is the number of forced leading frames.  The forced
    persona block is replayed (text + agent silence + user sine), then the USER
    stream is provided and the teacher generates agent+text.

    Streams are grouped by ``prompt_len`` so the forced block lines up, and
    ``LMGen`` runs ``batch_size`` streams at once (the plan's throughput fix).
    Returns one ``[1, 17, F]`` generated-code tensor per input sample.
    """
    from .models.lm import LMGen

    aps = 8
    if pad_token_id is None:
        pad_token_id = teacher_lm.zero_token_id
    gen = LMGen(teacher_lm, device=device, use_sampling=True, temp=temp,
                top_k=top_k, top_k_text=25, return_logits=False,
                fast_provided_tail=False)
    gen.eval()
    max_delay = gen.max_delay

    groups: dict[tuple, list[int]] = {}
    for i, (codes_i, plen) in enumerate(samples):
        plen = int(plen)
        # Group by the actual forced prompt BLOCK (not just its length): samples
        # sharing a persona/voice produce an identical block and batch together,
        # which is what makes "all samples" generation fast (plan §3.3).
        if plen > 0:
            block = (codes_i[0, :, :plen].detach().to(torch.int32).cpu()
                     .contiguous().numpy().tobytes())
            key = (plen, hash(block))
        else:
            key = (0, 0)
        groups.setdefault(key, []).append(i)

    results: list[torch.Tensor | None] = [None] * len(samples)
    n_done = 0
    for key, idxs in groups.items():
        plen = key[0]
        for j in range(0, len(idxs), batch_size):
            sel = idxs[j:j + batch_size]
            B = len(sel)
            T = max(samples[i][0].shape[-1] for i in sel)
            user = torch.full((B, aps, T), pad_token_id, dtype=torch.long, device=device)
            agent = torch.full((B, aps, T), pad_token_id, dtype=torch.long, device=device)
            text = torch.full((B, T), pad_token_id, dtype=torch.long, device=device)
            lens = []
            for r, i in enumerate(sel):
                c = samples[i][0].to(device)
                L = c.shape[-1]
                lens.append(L)
                user[r, :, :L] = c[0, 1 + aps:1 + 2 * aps]
                if plen > 0:
                    k = min(plen, L)
                    agent[r, :, :k] = c[0, 1:1 + aps, :k]
                    text[r, :k] = c[0, 0, :k]

            with gen.streaming(B):
                gen.reset_streaming()
                frames = []
                for f in range(T):
                    if f < plen:
                        out = gen.step(input_tokens=user[:, :, f:f + 1],
                                       moshi_tokens=agent[:, :, f:f + 1],
                                       text_token=text[:, f])
                    else:
                        out = gen.step(input_tokens=user[:, :, f:f + 1])
                    if out is None:
                        continue
                    if isinstance(out, tuple):
                        out = out[0]
                    if out is None:
                        continue
                    frames.append(out[:, :, 0])                 # [B, 17]
            if not frames:
                continue
            codes_gen = torch.stack(frames, dim=2)              # [B, 17, F]
            for r, i in enumerate(sel):
                # drop frames beyond this stream's own input length
                keep = max(1, lens[r] - max_delay)
                results[i] = codes_gen[r:r + 1, :, :keep].cpu()
            n_done += len(sel)
            if n_done % (batch_size * 10) < batch_size:
                logger.info("rollout: %d/%d samples generated", n_done, len(samples))

    out = [r for r in results if r is not None]
    logger.info("rollout_tokens_batched: %d/%d samples generated", len(out), len(samples))
    return out


@torch.no_grad()
def forced_prompt_len(codes: torch.Tensor, zero_token_id: int) -> int:
    """Length of the leading forced ``<system>`` persona block (plan §3.1).

    Detects the run where agent codebooks == ``SILENCE_TOKENS`` and user
    codebooks == ``SINE_TOKENS`` with real text.  Returns 0 when the chunk has
    no prompt (e.g. ``start_sec > 0``).
    """
    aps = AUDIO_TOKENS_PER_STREAM
    if codes.shape[1] < 1 + 2 * aps:
        return 0
    agent = codes[0, 1:1 + aps]
    user = codes[0, 1 + aps:1 + 2 * aps]
    silence = torch.as_tensor(SILENCE_TOKENS, dtype=agent.dtype,
                              device=agent.device).unsqueeze(1)
    sine = torch.as_tensor(SINE_TOKENS, dtype=user.dtype,
                           device=user.device).unsqueeze(1)
    match = ((agent == silence).all(0) & (user == sine).all(0)
             & (codes[0, 0] != zero_token_id))
    n, T = 0, codes.shape[-1]
    while n < T and bool(match[n]):
        n += 1
    return n


@torch.no_grad()
def collect_tokens(teacher_lm, loader, device, max_batches: int = 1000,
                   max_samples: int | None = None, batch_size: int = 32,
                   temp: float = 0.8, top_k: int = 250
                   ) -> list[torch.Tensor]:
    """Generate the tokens-only rollout cache (plan §3.1/§3.3).

    ``loader`` yields batches with ``.codes`` ``[B, 17, T]`` (interleaver output,
    persona already prepended).  Returns a list of ``[1, 17, F]`` teacher
    rollouts.  Storing only tokens is ~34 B/frame (~34 MB per 1M frames).
    """
    samples = []
    for i, batch in enumerate(loader):
        if i >= max_batches:
            break
        codes_all = batch.codes
        for b in range(codes_all.shape[0]):
            c = codes_all[b:b + 1]
            plen = forced_prompt_len(c, teacher_lm.zero_token_id)
            samples.append((c, plen))
            if max_samples is not None and len(samples) >= max_samples:
                break
        if max_samples is not None and len(samples) >= max_samples:
            break
    logger.info("collect_tokens: %d samples queued; generating...", len(samples))
    return rollout_tokens_batched(teacher_lm, samples, device=device,
                                  batch_size=batch_size, temp=temp, top_k=top_k)


def _collate_token_batch(tensors: list[torch.Tensor], pad_token_id: int,
                         device) -> torch.Tensor:
    """Stack ``[1,17,T_i]`` rollouts into ``[B,17,Tmax]`` (right-pad -1)."""
    B = len(tensors)
    T = max(t.shape[-1] for t in tensors)
    out = torch.full((B, 17, T), pad_token_id, dtype=torch.long, device=device)
    for r, t in enumerate(tensors):
        n = t.shape[-1]
        out[r, :, :n] = t[0, :, :n].to(device)
    return out




