def load_student_weights(student: LMModel, path: str | Path) -> LMModel:
    """Load a checkpoint into ``student``, casting floating tensors to the
    student's parameter dtype (so a bf16 checkpoint loads into an fp32-training
    student, and vice versa)."""
    pkg = torch.load(path, map_location="cpu", weights_only=False)
    sd = pkg["state_dict"] if isinstance(pkg, dict) and "state_dict" in pkg else pkg
    param_dtype = next(student.parameters()).dtype
    sd = {k: (v.to(param_dtype) if v.is_floating_point() else v)
          for k, v in sd.items()}
    student.load_state_dict(sd, strict=True)
    return student


def _resolve_ckpt_path(checkpoint: str | Path) -> Path:
    ckpt = Path(checkpoint)
    if ckpt.is_dir():
        ckpt = ckpt / "student.pt"
    if not ckpt.exists():
        raise FileNotFoundError(
            f"student checkpoint not found: {ckpt}. Pass a 'student.pt' file "
            f"or a step_<N> directory.")
    return ckpt


def load_student_backbone(checkpoint: str | Path, teacher_lm: LMModel,
                          device=None, dtype=None):
    """Rebuild a pruned backbone student from a `backbone_distill.py fit`
    checkpoint.  Returns ``(student_lm, kept_layers)``.

    Architecture comes from the checkpoint's stored ``base_kwargs`` when
    present (self-contained), else from the released config (`teacher_kwargs`).
    """
    ckpt = _resolve_ckpt_path(checkpoint)
    pkg = torch.load(ckpt, map_location="cpu", weights_only=False)
    if not isinstance(pkg, dict) or "kept_layers" not in pkg:
        raise ValueError(
            f"{ckpt} is not a pruned-backbone checkpoint (no 'kept_layers').")
    kept = list(pkg["kept_layers"])
    base_kwargs = pkg.get("base_kwargs") or teacher_kwargs(teacher_lm.dep_q)
    base_kwargs = dict(base_kwargs)
    base_kwargs["dep_q"] = int(teacher_lm.dep_q)
    n_q = int(getattr(teacher_lm, "n_q", base_kwargs.get("n_q", 16)))
    base_kwargs["n_q"] = n_q
    student = build_student(teacher_lm, kept, base_kwargs,
                            device=device, dtype=dtype)
    load_student_weights(student, ckpt)
    student.eval()
    return student, kept


def detect_student_kind(checkpoint: str | Path) -> str:
    """'pruned_backbone' or 'legacy_6p25hz', from the checkpoint keys."""
    pkg = torch.load(_resolve_ckpt_path(checkpoint), map_location="cpu",
                     weights_only=False)
    if not isinstance(pkg, dict):
        raise ValueError(f"unrecognized checkpoint (not a dict): {type(pkg)}")
    if "kept_layers" in pkg and "cfg" not in pkg:
        return "pruned_backbone"
    if "cfg" in pkg:
        return "legacy_6p25hz"
    raise ValueError(f"unrecognized checkpoint keys: {list(pkg.keys())}")


def _make_optimizer(params, lr: float, weight_decay: float, kind: str):
    if kind == "adamw8bit":
        try:
            import bitsandbytes as bnb
        except Exception as e:  # noqa: BLE001
            logger.warning("bitsandbytes unavailable (%s); falling back to AdamW", e)
            kind = "adamw"
        else:
            return bnb.optim.AdamW8bit(params, lr=lr, weight_decay=weight_decay)
    return torch.optim.AdamW(params, lr=lr, weight_decay=weight_decay,
                             betas=(0.9, 0.95))


def _lr_at(step: int, total: int, warmup: int, stage1_steps: int,
           lr_s1: float, lr_s2: float) -> float:
    base = lr_s1 if step < stage1_steps else lr_s2
    if step < warmup:
        return base * (step + 1) / max(1, warmup)
    t = (step - warmup) / max(1, total - warmup)
    import math
    return base * 0.5 * (1.0 + math.cos(math.pi * min(1.0, t)))


@torch.no_grad()
def evaluate(student: LMModel, teacher: LMModel, tokens: list[torch.Tensor],
             device, batch_size: int = 4, max_samples: int = 40,
             autocast_dtype: torch.dtype | None = None) -> dict[str, float]:
    """Held-out quality: hidden cosine, text top-1 agreement, PAD rate."""
    student.eval()
    pad = teacher.zero_token_id
    pad_ids = {teacher.text_padding_token_id, teacher.end_of_text_padding_id}
    cos_num = cos_den = 0.0
    agree_num = agree_den = 0.0
    agree_np_num = agree_np_den = 0.0
    pad_num = pad_den = 0.0
    tpad_num = 0.0
    idx = range(0, min(len(tokens), max_samples), batch_size)
    for s in idx:
        batch = _collate_token_batch(tokens[s:s + batch_size], pad, device)
        t_out = forward_distill(teacher, batch)
        if autocast_dtype is not None:
            with torch.autocast("cuda", dtype=autocast_dtype):
                s_out = forward_distill(student, batch)
        else:
            s_out = forward_distill(student, batch)
        valid = frame_valid_mask(batch, teacher.audio_offset, teacher.zero_token_id).float()
        cos = F.cosine_similarity(s_out["hidden"].float(), t_out["hidden"].float(), dim=-1)
        cos_num += float((cos * valid).sum()); cos_den += float(valid.sum())
        tm = t_out["text_mask"][:, 0].float()
        s_arg = s_out["text_logits"][:, 0].argmax(-1)
        t_arg = t_out["text_logits"][:, 0].argmax(-1)
        agree = ((s_arg == t_arg).float() * tm)
        agree_num += float(agree.sum()); agree_den += float(tm.sum())
        t_is_pad = torch.zeros_like(t_arg, dtype=torch.float)
        s_is_pad = torch.zeros_like(s_arg, dtype=torch.float)
        for pid in pad_ids:
            t_is_pad = torch.maximum(t_is_pad, (t_arg == pid).float())
            s_is_pad = torch.maximum(s_is_pad, (s_arg == pid).float())
        tpad_num += float((t_is_pad * tm).sum())
        nonpad = (t_is_pad == 0).float() * tm
        agree_np_num += float((agree * nonpad).sum()); agree_np_den += float(nonpad.sum())
        pad_num += float((s_is_pad * tm).sum()); pad_den += float(tm.sum())
    student.train()
    return {
        "cos_hidden": cos_num / max(cos_den, 1.0),
        "text_agree": agree_num / max(agree_den, 1.0),
        "text_agree_nonpad": agree_np_num / max(agree_np_den, 1.0),
        "text_pad_rate": pad_num / max(pad_den, 1.0),
        "teacher_pad_rate": tpad_num / max(pad_den, 1.0),
    }


def fit(teacher_lm, tokens: list[torch.Tensor], kept_layers: list[int], device,
        base_kwargs: dict | None = None, epochs: int = 4, batch_size: int = 8,
        lr_s1: float = 2e-5, lr_s2: float = 1e-5, stage1_frac: float = 0.2,
        grad_accum: int = 1, grad_clip: float = 1.0, weight_decay: float = 0.01,
        warmup_steps: int = 100, log_every: int = 10, eval_every: int = 200,
        save_every: int = 500, max_steps: int | None = None,
        out_dir: str | Path = "checkpoints/backbone_distill",
        student_dtype=torch.float32, autocast_dtype: torch.dtype | None = None,
        optimizer_kind: str = "adamw", held_out: int = 8, seed: int = 0,
        weights: BackboneDistillWeights | None = None,
        feat_layers: list[int] | None = None,
        save_dtype: torch.dtype | None = torch.bfloat16,
        samples_per_epoch: int | None = None) -> LMModel:
    """Distill a depth-pruned student from a tokens-only rollout cache.

    Stage 1 (first ``stage1_frac``): ``L_h + L_feat`` with embeddings/heads
    frozen.  Stage 2: ``L_h + L_text + w_audio*L_audio``, embeddings/heads
    unfrozen at ``lr_s2``.  Teacher is run online under ``no_grad``.
    """
    weights = weights or BackboneDistillWeights()
    base_kwargs = base_kwargs or teacher_kwargs()
    torch.manual_seed(seed)
    device = torch.device(device)

    teacher_lm.eval()
    for p in teacher_lm.parameters():
        p.requires_grad_(False)

    student = build_student(teacher_lm, kept_layers, base_kwargs,
                            device=device, dtype=student_dtype)
    student._kept_layers = kept_layers
    # pick a few top student layers for L_feat, mapped to their teacher layers
    if feat_layers is None and len(kept_layers) >= 3:
        feat_layers = [len(kept_layers) - 3]
    student._feat_layers = feat_layers or None

    # optimizer over all potentially-trainable params (depformer stays frozen)
    opt_params = [p for p in student.parameters() if p.requires_grad]
    opt = _make_optimizer(opt_params, lr=lr_s1, weight_decay=weight_decay,
                          kind=optimizer_kind)
    logger.info("student %d layers | trainable params %.2fB | optim %s | dtype %s",
                len(kept_layers),
                sum(p.numel() for p in opt_params) / 1e9, optimizer_kind,
                student_dtype)

    held_out = min(held_out, max(0, len(tokens) - 1))
    train_tokens = tokens[:-held_out] if held_out else tokens
    eval_tokens = tokens[-held_out:] if held_out else []
    n_steps_per_epoch = max(1, len(train_tokens) // batch_size)
    total_steps = max_steps or n_steps_per_epoch * epochs
    stage1_steps = int(total_steps * stage1_frac)
    freeze_embeddings_and_heads(student, True)   # stage 1

    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    pad = teacher_lm.zero_token_id

    step, micro, t0 = 0, 0, time.time()
    opt.zero_grad()
    for epoch in range(epochs):
        torch.manual_seed(seed + epoch)
        perm = torch.randperm(len(train_tokens)).tolist()
        epoch_sel = perm[:samples_per_epoch] if samples_per_epoch else perm
        for s in range(0, len(epoch_sel) - batch_size + 1, batch_size):
            if step >= total_steps:
                break
            stage = 1 if step < stage1_steps else 2
            if step == stage1_steps:
                freeze_embeddings_and_heads(student, False)
                logger.info("step %d: switching to stage 2 (embeddings/heads "
                            "unfrozen, lr=%.1e)", step, lr_s2)

            sel = [train_tokens[i] for i in epoch_sel[s:s + batch_size]]
            codes = _collate_token_batch(sel, pad, device)
            loss, stats = train_step(student, teacher_lm, codes, weights, stage,
                                     autocast_dtype=autocast_dtype)
            (loss / grad_accum).backward()
            micro += 1
            if micro < grad_accum:
                continue
            micro = 0
            nn.utils.clip_grad_norm_(
                [p for p in student.parameters() if p.requires_grad], grad_clip)
            lr = _lr_at(step, total_steps, warmup_steps, stage1_steps, lr_s1, lr_s2)
            for g in opt.param_groups:
                g["lr"] = lr
            opt.step()
            opt.zero_grad()
            step += 1

            if step % log_every == 0:
                logger.info("epoch %d step %d/%d stage %d lr=%.2e %s (%.0fs)",
                            epoch, step, total_steps, stage, lr,
                            " ".join(f"{k}={v:.4f}" for k, v in stats.items()),
                            time.time() - t0)
            if eval_tokens and step % eval_every == 0:
                ev = evaluate(student, teacher_lm, eval_tokens, device,
                              autocast_dtype=autocast_dtype)
                logger.info("[eval] step %d cos_hidden=%.4f text_agree=%.4f "
                            "text_agree_nonpad=%.4f pad_rate=%.4f (teacher %.4f)",
                            step, ev["cos_hidden"], ev["text_agree"],
                            ev["text_agree_nonpad"], ev["text_pad_rate"],
                            ev["teacher_pad_rate"])
            if step % save_every == 0:
                _save_student(out_dir / f"step_{step}", student, kept_layers, stats,
                              save_dtype=save_dtype, base_kwargs=base_kwargs)
        if step >= total_steps:
            break

    _save_student(out_dir / f"step_{step}", student, kept_layers,
                  {"step": step}, save_dtype=save_dtype, base_kwargs=base_kwargs)
    logger.info("done: %d steps", step)
    return student


def _save_student(path: Path, student: LMModel, kept_layers: list[int],
                  stats: dict, save_dtype: torch.dtype | None = torch.bfloat16,
                  base_kwargs: dict | None = None) -> None:
    """Save the student in ``save_dtype`` (bf16 by default).

    Training uses fp32 master weights, but the deployment target (and the
    teacher checkpoint) is bf16, so bf16 is the default on disk: 2x smaller and
    directly loadable without a cast.  ``base_kwargs`` (the teacher constructor
    kwargs) is stored so the server can rebuild the exact architecture.
    """
    path.mkdir(parents=True, exist_ok=True)
    sd = student.state_dict()
    if save_dtype is not None:
        sd = {k: (v.to(save_dtype) if v.is_floating_point() else v)
              for k, v in sd.items()}
    meta = {
        "state_dict": sd,
        "kept_layers": kept_layers,
        "save_dtype": str(save_dtype),
        "stats": {k: float(v) for k, v in stats.items()
                  if isinstance(v, (int, float))},
    }
    if base_kwargs is not None:
        meta["base_kwargs"] = {k: v for k, v in base_kwargs.items()
                               if not isinstance(v, torch.dtype)}
    torch.save(meta, path / "student.pt")
    logger.info("saved %s (%s)", path / "student.pt", save_dtype)


