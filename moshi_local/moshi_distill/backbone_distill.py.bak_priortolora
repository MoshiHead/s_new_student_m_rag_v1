@torch.no_grad()
def layer_drop_ablation(teacher_lm, codes: torch.Tensor, base_kwargs: dict,
                        candidates: list[int] | None = None,
                        frame_valid: torch.Tensor | None = None
                        ) -> list[tuple[int, float, float]]:
    """Leave-one-out ranking: drop one layer, measure Δcos(h) and Δtext KL.

    Returns ``[(layer, mean_cosine_to_teacher, text_kl_diff), ...]`` sorted by the
    most harmful (lowest cosine) first.  No training needed.
    """
    n = len(teacher_lm.transformer.layers)
    if candidates is None:
        candidates = list(range(n))
    t_out = forward_distill(teacher_lm, codes)
    if frame_valid is None:
        frame_valid = codes[:, teacher_lm.audio_offset] != teacher_lm.zero_token_id
    rows = []
    for l in candidates:
        kept = [i for i in range(n) if i != l]
        s = build_student(teacher_lm, kept, dict(base_kwargs),
                          dtype=next(teacher_lm.parameters()).dtype)
        s.eval()
        s_out = forward_distill(s, codes)
        cos = F.cosine_similarity(s_out["hidden"].float(), t_out["hidden"].float(),
                                  dim=-1)                          # [B, T]
        w = frame_valid.float()
        mean_cos = float((cos * w).sum() / w.sum().clamp(min=1e-8))
        rows.append((l, mean_cos, 0.0))
        del s
    rows.sort(key=lambda r: r[1])
    return rows




def train_step(student: LMModel, teacher: LMModel, codes: torch.Tensor,
               weights: BackboneDistillWeights, stage: int,
               autocast_dtype: torch.dtype | None = None
               ) -> tuple[torch.Tensor, dict[str, float]]:
    """One teacher-online distillation step. Returns (loss, stats).

    The caller owns backward/optimizer so it can do gradient accumulation.
    """
    pad_ids = {teacher.text_padding_token_id, teacher.end_of_text_padding_id}
    s_feat_layers = getattr(student, "_feat_layers", None)
    with torch.no_grad():
        if s_feat_layers:
            t_feat_layers = [student._kept_layers[i] for i in s_feat_layers]
            t_out = forward_distill(teacher, codes, feat_layers=t_feat_layers)
            t_out["feats"] = {s: t_out["feats"][t]
                              for s, t in zip(s_feat_layers, t_feat_layers)}
        else:
            t_out = forward_distill(teacher, codes)

    if autocast_dtype is not None:
        with torch.autocast(device_type="cuda", dtype=autocast_dtype):
            s_out = forward_distill(student, codes, feat_layers=s_feat_layers)
    else:
        s_out = forward_distill(student, codes, feat_layers=s_feat_layers)
    frame_valid = frame_valid_mask(codes, teacher.audio_offset, teacher.zero_token_id)
    loss, stats = backbone_distill_loss(s_out, t_out, codes, frame_valid,
                                        pad_ids, weights, stage)
    return loss, stats


